# Copy to .env and fill in. Restart `npm run dev` after changes.

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Hotel name (shown in emails + UI)
VITE_HOTEL_NAME=Tabarak Hotel & Restaurant
HOTEL_NAME=Tabarak Hotel & Restaurant

# --- Guest emails (Nodemailer) ---
# Local: used by `npm run email-server` / `npm run dev`
# Vercel: add the SAME SMTP_* (and HOTEL_NAME) in Vercel → Settings → Environment Variables
#   Do NOT prefix them with VITE_ — those would expose secrets in the browser.
# Production on Vercel uses /api/send-guest-email (see /api folder). Leave VITE_EMAIL_API_URL empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_SERVER_PORT=8787

# Only if the email API is on a different domain (not needed for Vercel /api):
# VITE_EMAIL_API_URL=
# Seed script only
ADMIN_EMAIL=
ADMIN_PASSWORD=
