rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.role == 'admin'
        );
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validRoomCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'number', 'floor', 'type', 'rate', 'capacity', 'beds',
          'description', 'images', 'status', 'cleaningStatus',
          'cleanedBy', 'cleaningBy', 'guest', 'booking', 'openOrders',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && d.number is string
        && d.number.size() > 0
        && d.number.size() <= 20
        && d.floor is number
        && d.floor >= 0
        && d.type is string
        && d.rate is number
        && d.rate >= 0
        && d.capacity is number
        && d.capacity >= 1
        && d.beds is number
        && d.beds >= 1
        && d.description is string
        && d.images is list
        && d.images.size() <= 6
        && d.status in ['available', 'occupied', 'reserved', 'maintenance', 'cleaning']
        && d.cleaningStatus in ['clean', 'dirty', 'cleaning_in_progress']
        && d.openOrders is number
        && d.createdBy == request.auth.uid;
    }

    function validRoomUpdate() {
      let d = request.resource.data;
      return d.number is string
        && d.number.size() > 0
        && d.floor is number
        && d.type is string
        && d.rate is number
        && d.capacity is number
        && d.beds is number
        && d.images is list
        && d.images.size() <= 6
        && d.status in ['available', 'occupied', 'reserved', 'maintenance', 'cleaning']
        && d.cleaningStatus in ['clean', 'dirty', 'cleaning_in_progress']
        && d.openOrders is number;
    }

    // Roles — any staff can read; only admin can create/update/delete
    match /roles/{roleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Users — staff can read; admin manages
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Rooms — signed-in staff can manage (check-in / housekeeping will update later)
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && validRoomCreate();
      allow update: if signedIn() && validRoomUpdate();
      allow delete: if isAdmin();
    }

    // Check-ins — signed-in staff can create/list; admin can delete
    match /checkIns/{checkInId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Employees — signed-in staff manage roster
    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Duty roster — signed-in staff assign tasks and supervisors
    match /dutyRoster/{dutyId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Attendance — signed-in staff clock employees in/out
    match /attendance/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Housekeeping tasks — signed-in staff
    match /housekeepingTasks/{taskId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Booking requests
    match /bookingRequests/{requestId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Food orders — billed to active check-in / room
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    // Menu catalog (when Menu page writes to Firestore)
    match /menuItems/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Guest feedback — anyone can submit; only staff can read/manage
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll([
          'guestName', 'phone', 'email', 'roomNumber',
          'rating', 'category', 'message', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.roomNumber is string
        && request.resource.data.roomNumber.size() <= 20
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.category in [
          'hotel', 'restaurant', 'staff', 'cleanliness', 'other'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new';
      allow read, update, delete: if signedIn();
    }

    // Rest of the app data — signed-in staff for now
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
